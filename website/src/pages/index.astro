---
import SiteLayout from '../kit/SiteLayout.astro';
import Shot from '../kit/Shot.astro';
import Keys from '../kit/Keys.astro';
import ModeToggle from '../kit/ModeToggle.astro';
import ThemeDial from '../kit/ThemeDial.astro';
import Lightbox from '../kit/Lightbox.astro';
import FamilyFooter from '../kit/FamilyFooter.astro';
import { family, url } from '../kit/family';

const GITHUB = 'https://github.com/NikiforovAll/claude-code-marketplace';
const NPM = 'https://www.npmjs.com/package/claude-code-marketplace';
const INSTALL = 'npx claude-code-marketplace --open';

const find = [
  {
    title: 'Search every marketplace at once',
    body: 'Type in the filter and each marketplace narrows to the plugins that match. The match is marked in names and descriptions, and the arrow keys step through the results while you type.',
    shot: 'h1d-hub-marketplace-search',
    alt: 'Search for "review" across the claude-plugins-official marketplace, with code-review open',
  },
  {
    title: 'Read a skill before you install it',
    body: 'Open any skill, command, agent, or hook and read its files with syntax highlighting. A plugin you have not installed shows its files too.',
    shot: 'h1c-hub-marketplace-skill',
    alt: 'The SKILL.md file of skill-creator open in the file preview, with the skill folder listed on the left',
  },
];

const manage = [
  {
    title: 'Install in the scope you want',
    body: 'Each plugin has a row for user, project, and local scope. Install, enable, disable, or remove it in each one. The U, P, and L badges in the tree show where a plugin is on.',
    shot: 'h1b-hub-marketplace-plugin',
    alt: 'The engineering plugin with install buttons for user, project, and local scope, and its skills and MCP servers',
  },
  {
    title: 'Add a marketplace',
    body: 'Paste a GitHub repo, a git URL, or a local folder. The list shows how many plugins you installed from each source, out of how many it has.',
    shot: 'h1e-hub-marketplace-add',
    alt: 'The Marketplaces dialog with a GitHub repo typed in and seven registered marketplaces',
  },
  {
    title: 'Keep your hands on the keyboard',
    body: 'Arrow keys move through the tree, [/] searches, [S] picks the scope filter, and [E] opens a plugin in your editor. Inside Claude Code Hub, [Ctrl+Alt+Left] and [Ctrl+Alt+Right] switch apps. Press [?] for the full list.',
    shot: 'h1f-hub-marketplace-shortcuts',
    alt: 'Keyboard shortcuts help, grouped by navigate, find, open, view, and hub',
  },
];

const setup = [
  {
    title: 'Check Claude Code',
    cmd: 'claude --version',
    body: 'Installs and removals run through the claude plugin CLI, so it must be on your PATH.',
  },
  {
    title: 'Start the dashboard',
    cmd: INSTALL,
    body: 'It reads the plugin registry in ~/.claude/plugins/. For project and local scope, pick a project with [Shift+P].',
  },
];
---

<SiteLayout
  title="Claude Code Marketplace: browse and install Claude Code plugins"
  description="Browse, install, and manage Claude Code plugins from every marketplace you use."
  image="og.png"
>
  <div class="page">
    <header class="nav">
      <a class="mark" href={url()}>Claude Code Marketplace</a>
      <nav aria-label="Site">
        <a href={url('getting-started/')}>Docs</a>
        <a href={GITHUB}>GitHub</a>
        <details class="family">
          <summary>Apps</summary>
          <ul>
            {family.map((s) => <li><a href={s.href} aria-current={s.id === 'marketplace' ? 'page' : undefined}>{s.name}</a></li>)}
          </ul>
        </details>
        <ModeToggle />
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Every Claude Code plugin you can install, in one tree.</h1>
        <p class="lede">
          Add the marketplaces you use. Search their plugins, read a skill before you install it, and turn each plugin on
          for yourself, for one project, or only on your machine.
        </p>
        <div class="actions">
          <div class="cmd">
            <code><span aria-hidden="true">$ </span>{INSTALL}</code>
            <button type="button" class="copy" data-copy={INSTALL}>Copy</button>
          </div>
          <a class="button" href={url('getting-started/')}>Read the docs</a>
        </div>

        <figure class="hero-shot">
          <Shot
            themed="marketplace"
            alt="Claude Code Marketplace: installed plugins grouped by marketplace, with frontend-design open in the panel"
            eager
          />
          <figcaption>
            <ThemeDial />
            <p>The 17 themes the app ships with, in light and dark. Pick one and the page follows.</p>
          </figcaption>
        </figure>
      </section>

      <section class="half" aria-labelledby="find">
        <div class="half-head">
          <h2 id="find">Find</h2>
          <p>
            The dashboard reads the marketplaces you added to Claude Code and every plugin they offer, installed or not.
            Nothing to configure.
          </p>
        </div>
        <div class="items">
          {
            find.map((it) => (
              <article class="item">
                <div class="item-text">
                  <h3>{it.title}</h3>
                  <p><Keys text={it.body} /></p>
                </div>
                <Shot themed={it.shot} alt={it.alt} />
              </article>
            ))
          }
        </div>
      </section>

      <section class="half" aria-labelledby="manage">
        <div class="half-head">
          <h2 id="manage">Manage</h2>
          <p>
            Every change runs through the <code>claude plugin</code> CLI, so Claude Code sees the same state as the
            dashboard.
          </p>
          <p class="aside">
            Inside Claude Code Hub, the project you pick with <kbd>Ctrl+Alt+P</kbd> sets the project scope.
          </p>
        </div>
        <div class="items">
          {
            manage.map((it) => (
              <article class="item">
                <div class="item-text">
                  <h3>{it.title}</h3>
                  <p><Keys text={it.body} /></p>
                </div>
                <Shot themed={it.shot} alt={it.alt} />
              </article>
            ))
          }
        </div>
      </section>

      <section class="groups" aria-labelledby="custom">
        <div class="groups-text">
          <h2 id="custom">Your own skills sit next to the plugins</h2>
          <p>
            The skills, commands, agents, and hooks in <code>~/.claude/</code> and in your project's <code>.claude/</code>
            show up as two more marketplaces. Browse and preview them the same way.
          </p>
        </div>
        <Shot themed="h1-hub-marketplace" alt="User Customizations open in the panel, with its settings and CLAUDE.md" />
      </section>

      <section class="setup" aria-labelledby="setup">
        <h2 id="setup">Set up in two steps</h2>
        <ol>
          {
            setup.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <code class="step-cmd">{s.cmd}</code>
                {s.body && <p><Keys text={s.body} /></p>}
              </li>
            ))
          }
        </ol>
      </section>
    </main>

    <FamilyFooter
      current="marketplace"
      links={[
        { label: 'MIT license', href: `${GITHUB}/blob/main/LICENSE` },
        { label: 'npm', href: NPM },
        { label: 'GitHub', href: GITHUB },
      ]}
    />
  </div>
  <Lightbox />
</SiteLayout>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  .page {
    width: min(100% - 2rem, 78rem);
    margin-inline: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }
  .mark {
    font: 600 1.25rem/1 var(--font-display);
    color: var(--c-ink1);
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font: 500 0.875rem var(--font-mono);
  }
  .nav nav a,
  .family summary {
    color: var(--c-ink2);
    text-decoration: none;
    cursor: pointer;
  }
  .nav nav a:hover,
  .family summary:hover {
    color: var(--c-ink1);
  }
  .family {
    position: relative;
  }
  .family summary {
    list-style: none;
  }
  .family summary::-webkit-details-marker {
    display: none;
  }
  .family summary::after {
    content: ' ▾';
  }
  .family ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 10;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    min-width: 11rem;
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0.5rem;
  }
  .family li a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
  }
  .family li a:hover {
    background: var(--c-hover);
  }
  .family li a[aria-current='page'] {
    color: var(--c-accent-ink);
  }

  .hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) 0;
  }
  h1 {
    margin: 0;
    font: 600 clamp(2.5rem, 6.4vw, 5.75rem) / 0.98 var(--font-display);
    letter-spacing: -0.025em;
    max-width: 22ch;
  }
  .lede {
    margin: 1.75rem 0 0;
    max-width: 38rem;
    font-size: 1.1875rem;
    color: var(--c-ink2);
  }
  .actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cmd {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0.5rem;
    max-width: 100%;
  }
  .cmd code {
    font-size: 0.9375rem;
    white-space: nowrap;
    overflow-x: auto;
  }
  .cmd code span {
    color: var(--c-muted);
  }
  .copy,
  .button {
    font: 500 0.875rem/1 var(--font-mono);
    padding: 0.625rem 0.875rem;
    border-radius: 0.375rem;
    cursor: pointer;
    text-decoration: none;
  }
  .copy {
    color: var(--c-ink2);
    background: transparent;
    border: 1px solid transparent;
    min-width: 5.5rem;
  }
  .copy:hover {
    background: var(--c-hover);
  }
  .button {
    display: inline-flex;
    align-items: center;
    color: var(--c-field);
    background: var(--c-ink1);
    border: 1px solid var(--c-ink1);
  }
  .button:hover {
    background: var(--c-accent-ink);
    border-color: var(--c-accent-ink);
  }
  .copy:focus-visible,
  .button:focus-visible,
  .nav a:focus-visible,
  .family summary:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  .hero-shot {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  }
  .hero-shot figcaption {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }
  .hero-shot figcaption p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-ink3);
  }

  .half {
    margin-top: clamp(5rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: minmax(14rem, 18rem) 1fr;
    gap: 2rem clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .half-head {
    position: sticky;
    top: 2rem;
  }
  .half-head h2 {
    margin: 0 0 1rem;
    font: 600 clamp(3.5rem, 8vw, 6rem) / 0.9 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--c-accent-ink);
  }
  .half-head p {
    margin: 0 0 1rem;
    color: var(--c-ink2);
  }
  .aside {
    font-size: 0.9375rem;
    color: var(--c-ink3);
  }
  .half-head code,
  .groups-text code,
  .item-text code {
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    margin: 0 0.15em;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 0.3em;
    white-space: nowrap;
  }
  @media (max-width: 360px) {
    .half-head code,
    .groups-text code,
    .item-text code {
      white-space: normal;
      overflow-wrap: anywhere;
      box-decoration-break: clone;
    }
  }
  .items {
    display: grid;
    gap: clamp(3.5rem, 6vw, 5.5rem);
  }
  .item {
    display: grid;
    gap: 1.25rem;
  }
  .item-text {
    max-width: 40rem;
  }
  .item h3,
  .setup h3 {
    margin: 0 0 0.5rem;
    font: 600 1.625rem/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .item p {
    margin: 0;
    color: var(--c-ink2);
  }
  .groups {
    margin-top: clamp(5rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: minmax(14rem, 22rem) 1fr;
    gap: 2rem clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  h2 {
    margin: 0 0 1rem;
    font: 600 clamp(2rem, 4vw, 2.75rem) / 1.08 var(--font-display);
    letter-spacing: -0.02em;
  }
  .groups p {
    margin: 0;
    color: var(--c-ink2);
  }

  .setup {
    margin-block: clamp(5rem, 10vw, 9rem) clamp(4rem, 8vw, 6rem);
  }
  .setup ol {
    margin: 2rem 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }
  .setup li {
    counter-increment: step;
    padding-top: 1.25rem;
    border-top: 2px solid var(--c-ink1);
  }
  .setup li::before {
    content: counter(step);
    display: block;
    font: 600 1rem var(--font-mono);
    color: var(--c-accent-ink);
    margin-bottom: 0.5rem;
  }
  .step-cmd {
    display: block;
    margin: 0.75rem 0;
    padding: 0.625rem 0.875rem;
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    overflow-x: auto;
    white-space: nowrap;
  }
  .setup li p {
    margin: 0;
    color: var(--c-ink2);
    font-size: 0.9375rem;
  }

  @media (max-width: 52rem) {
    .half,
    .groups {
      grid-template-columns: 1fr;
    }
    .half-head {
      position: static;
    }
    .nav nav {
      gap: 0.875rem;
    }
  }
</style>
